# ===========================================
# NEUROPLAN BACKEND - CONFIGURACIÓN SEGURA
# ===========================================
# Copia este archivo como .env y configura tus valores reales

# ===========================================
# CONFIGURACIÓN SUPABASE
# ===========================================
# Obtén estos valores desde tu panel de Supabase
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu_anon_key_aqui"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"

# ===========================================
# BASE DE DATOS POSTGRESQL (SUPABASE)
# ===========================================
# Cadena de conexión de Supabase (desde Settings > Database)
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO].supabase.co:5432/postgres"

# ===========================================
# AUTENTICACIÓN JWT
# ===========================================
# Genera un secreto fuerte para producción
JWT_SECRET="genera_un_secreto_muy_fuerte_y_aleatorio_aqui"
JWT_EXPIRES_IN="24h"

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ===========================================
# SERVICIOS AWS (MODO MOCK POR DEFECTO)
# ===========================================
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="mock"
AWS_SECRET_ACCESS_KEY="mock"
AWS_S3_BUCKET="neuroplan-demo-bucket"
AWS_BEDROCK_API_KEY="mock"
AWS_TEXTRACT_API_KEY="mock"
AWS_COMPREHEND_API_KEY="mock"

# ===========================================
# SERVICIOS EXTERNOS (MODO MOCK POR DEFECTO)
# ===========================================
N8N_URL="http://localhost:5678"
N8N_API_KEY="mock"
ELEVENLABS_API_KEY="mock"

# ===========================================
# CONFIGURACIÓN DE ARCHIVOS
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"