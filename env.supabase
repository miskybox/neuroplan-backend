# ===========================================
# NEUROPLAN BACKEND - CONFIGURACIÓN SUPABASE
# ===========================================

# ===========================================
# SUPABASE (RECOMENDADO)
# ===========================================
# Configuración para producción y desarrollo
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ===========================================
# AUTENTICACIÓN JWT
# ===========================================
JWT_SECRET="neuroplan-jwt-secret-key-2024-change-in-production"
JWT_EXPIRES_IN="24h"

# ===========================================
# SERVIDOR
# ===========================================
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:8080"
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173,http://localhost:3000"

# ===========================================
# AWS SERVICES (MOCK MODE)
# ===========================================
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="mock"
AWS_SECRET_ACCESS_KEY="mock"
AWS_S3_BUCKET="neuroplan-demo-bucket"

# AWS Bedrock (Claude AI)
AWS_BEDROCK_API_KEY="mock"

# AWS Textract (OCR)
AWS_TEXTRACT_API_KEY="mock"

# AWS Comprehend (NLP)
AWS_COMPREHEND_API_KEY="mock"

# AWS Polly (Text-to-Speech)
AWS_POLLY_API_KEY="mock"

# ===========================================
# SERVICIOS EXTERNOS (MOCK MODE)
# ===========================================
# Claude AI (Anthropic)
CLAUDE_API_KEY="mock"

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY="mock"
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"

# N8N (Workflow Automation)
N8N_URL="http://localhost:5678"
N8N_API_KEY="mock"
N8N_WEBHOOK_URL="mock"

# Linkup (Educational Resources)
LINKUP_API_KEY="mock"

# ===========================================
# CONFIGURACIÓN DE ARCHIVOS
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

