{
  "name": "neuroplan-mvp",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
